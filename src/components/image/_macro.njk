{%- macro onsImage(params) -%}
    {% from "components/figure/_macro.njk" import onsFigure %}

    {%
        call onsFigure({
            "id": params.id if params.id,
            "headingLevel": params.headingLevel if params.headingLevel,
            "title": params.title if params.title,
            "subtitle": params.subtitle if params.subtitle,
            "caption": params.caption if params.caption,
            "footnotes": params.footnotes if params.footnotes,
            "download": params.download if params.download
        })
    %}
        <div class="ons-image">
            {% if params.image %}
                <img
                    class="ons-image__img"
                    {% if params.image.largeSrc %}srcset="{{ params.image.smallSrc }} 1x, {{ params.image.largeSrc }} 2x"{% endif %}src="{{ params.image.smallSrc }}"
                    alt="{{ params.alt if params.alt }}"
                />
            {% else %}
                <img class="ons-image__img" src="{{ params.src }}" alt="{{ params.alt }}" />
            {% endif %}
        </div>
    {% endcall %}
{%- endmacro -%}
