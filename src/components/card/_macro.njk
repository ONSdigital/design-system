{%- macro onsCard(params) -%}
    {% set headingLevel = params.title.headingLevel | default(2) | string %}
    {% set openingHeadingTag = "<h" + headingLevel %}
    {% set closingHeadingTag = "</h" + headingLevel + ">" %}
    {% set placeholderSrcset = (params.image.placeholderUrl if params.image.placeholderUrl else "") + "/img/small/placeholder-card.png 1x, " + (params.image.placeholderUrl if params.image.placeholderUrl else "") + "/img/large/placeholder-card.png 2x" %}
    {% set topAlignedFigure = params.variant == 'feature' and params.figureAlignment == 'top' and params.body.figure %}
    {% set showSparkline = params.variant == 'feature' and params.body.figure and params.sparkline %}
    {% set cardClasses = 'ons-card' %}
    {% if params.variant == 'feature' %}
        {% set cardClasses = cardClasses + ' ons-card--feature ons-u-flex-grow' %}
    {% endif %}
    {% if topAlignedFigure %}
        {% set cardClasses = cardClasses + ' ons-card--figure-top' %}
    {% endif %}
    {% if showSparkline %}
        {% set cardClasses = cardClasses + ' ons-card--with-sparkline' %}
    {% endif %}

    <div class="{{ cardClasses }}">
        {% set imageBlock %}
            {%- if params.image -%}
                {% if params.image.smallSrc %}
                    <img
                        class="ons-card__image ons-u-mb-s"
                        height="200"
                        width="303"
                        {% if params.image.largeSrc %}srcset="{{ params.image.smallSrc }} 1x, {{ params.image.largeSrc }} 2x"{% endif %}
                        src="{{ params.image.smallSrc }}"
                        alt="{{ params.image.alt }}"
                        loading="lazy"
                    />
                {% elif params.image == true or params.image.placeholderUrl %}
                    <img
                        class="ons-card__image ons-u-mb-s "
                        height="100"
                        width="303"
                        srcset="{{ placeholderSrcset }}"
                        src="{{- params.image.placeholderUrl if params.image.placeholderUrl -}}/img/small/placeholder-card.png"
                        alt=""
                        loading="lazy"
                    />
                {% endif %}
            {%- endif -%}
        {% endset %}


        {% set titleBlock %}
            {{ openingHeadingTag | safe }}
            class="ons-card__title {{ params.title.classes | default('ons-u-fs-m') }}" id="{{ params.title.id }}"> {{ params.title.text }}
            {{ closingHeadingTag | safe }}
        {% endset %}


        {% set headingBlock %}
            {% if params.title.url %}
                <a href="{{ params.title.url }}" class="ons-card__link{% if params.title.subtitle %}{{ ' ' }}ons-u-mb-xs{% endif %}">
                    {{ imageBlock | safe }}
                    {{ titleBlock | safe }}
                </a>
            {% else %}
                {{ imageBlock | safe }}
                {{ titleBlock | safe }}
            {% endif %}

            {% if params.title.subtitle %}
                <p class="ons-card__subtitle ons-u-fs-s">{{ params.title.subtitle }}</p>
            {% endif %}
        {% endset %}

        {% if params.variant == 'feature' and params.body.figure %}
            <div class="ons-card__heading">{{ headingBlock | safe }}</div>
        {% else %}
            {{ headingBlock | safe }}
        {% endif %}


        {% set bodyBlock %}
            {% if showSparkline %}
                <svg class="ons-card__sparkline" viewBox="0 26 308 120" aria-hidden="true" focusable="false">
                    <path d="M3 97 V121 L60 39 L114 109 L170 132 L220 97 H280 L305 69 V97 Z" fill="var(--ons-color-soft-blue-grey)" />
                    <path d="M3 97 H305" stroke="var(--ons-color-grey-35)" stroke-width="2" />
                    <path
                        d="M3 121 L60 39 L114 109 L170 132 L220 97 H280 L305 69"
                        fill="none"
                        stroke="var(--ons-color-ocean-blue)"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="5"
                    />
                </svg>
            {% endif %}
            {% if params.body.figure %}
                <p class="ons-card__figure ons-u-fs-3xl ons-u-fw-b ons-u-mb-no">{{ params.body.figure }}</p>
            {% endif %}

            <p id="{{ params.body.id }}" class="ons-card__body">{{ params.body.text }}</p>

            {%- if params.body.itemsList -%}
                {% from "components/list/_macro.njk" import onsList %}
                {{
                    onsList({
                        "variants": 'dashed',
                        "itemsList": params.body.itemsList
                    })
                }}
            {% endif %}
        {% endset %}

        {% if topAlignedFigure or showSparkline %}
            <div class="ons-card__content">{{ bodyBlock | safe }}</div>
        {% else %}
            {{ bodyBlock | safe }}
        {% endif %}
    </div>
{%- endmacro -%}
