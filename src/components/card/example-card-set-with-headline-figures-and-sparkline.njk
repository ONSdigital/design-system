{% from "components/card/_macro.njk" import onsCard %}

<div class="ons-container ons-container--wide">
    <div class="ons-grid ons-grid-flex-gap ons-grid-flex-gap--s ons-card-set--headline-figures ons-card-set--with-sparkline">
        <div class="ons-grid__col ons-grid__col--flex-col ons-grid__col--stretch">
            {{
                onsCard({
                    "variant": 'feature',
                    "title": {
                        "id": 'sparkline-card-1',
                        "text": 'Deaths registered annually',
                        "subtitle": 'England and Wales'
                    },
                    "body": {
                        "id": 'sparkline-text-1',
                        "figure": '581,363',
                        "text": 'In 2023, up 0.7% from 2022'
                    }
                })
            }}
        </div>

        <div class="ons-grid__col ons-grid__col--flex-col ons-grid__col--stretch">
            {{
                onsCard({
                    "variant": 'feature',
                    "title": {
                        "id": 'sparkline-card-2',
                        "text": 'Alcohol-specific deaths',
                        "subtitle": 'UK'
                    },
                    "body": {
                        "id": 'sparkline-text-2',
                        "figure": '10,473',
                        "text": 'In 2023, the highest number on record, with supporting text that can wrap over several lines'
                    }
                })
            }}
        </div>

        {# Illustrative sparkline markup; this is not a card macro option. #}
        <div class="ons-grid__col ons-grid__col--flex-col ons-grid__col--stretch">
            <div class="ons-card ons-card--feature ons-u-flex-grow">
                <div class="ons-card__heading">
                    <h2 class="ons-card__title ons-u-fs-m" id="sparkline-card-3">Illustrative headline</h2>
                    <p class="ons-card__subtitle ons-u-fs-s">England and Wales</p>
                </div>
                <p class="ons-card__figure ons-u-fs-3xl ons-u-fw-b ons-u-mb-no">6.15 Million households</p>
                <p class="ons-card__body" id="sparkline-text-3">An illustrative figure with a decorative trend line</p>
                <svg class="ons-card__sparkline" viewBox="0 0 240 48" aria-hidden="true" focusable="false">
                    <path
                        d="M2 38 L34 32 L66 36 L98 20 L130 27 L162 14 L194 18 L238 4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                    />
                </svg>
            </div>
        </div>
    </div>
</div>
