{% from "components/card/_macro.njk" import onsCard %}

<div class="ons-container ons-container--wide">
    <div class="ons-grid ons-grid-flex-gap ons-card-set--headline-figures">
        <div class="ons-grid__col ons-grid__col--flex-col">
            {{
                onsCard({
                    "variant": 'feature',
                    "figureAlignment": 'top',
                    "sparkline": true,
                    "title": {
                        "id": 'sparkline-card-1',
                        "text": 'Deaths registered annually',
                        "subtitle": 'England and Wales'
                    },
                    "body": {
                        "id": 'sparkline-text-1',
                        "figure": '581,363',
                        "text": 'In 2023, up 0.7% from 2022'
                    }
                })
            }}
        </div>

        <div class="ons-grid__col ons-grid__col--flex-col">
            {{
                onsCard({
                    "variant": 'feature',
                    "figureAlignment": 'top',
                    "sparkline": true,
                    "title": {
                        "id": 'sparkline-card-2',
                        "text": 'Alcohol-specific deaths',
                        "subtitle": 'UK'
                    },
                    "body": {
                        "id": 'sparkline-text-2',
                        "figure": '10,473',
                        "text": 'In 2023, the highest number on record, with supporting text that can wrap over several lines'
                    }
                })
            }}
        </div>

        <div class="ons-grid__col ons-grid__col--flex-col">
            {{
                onsCard({
                    "variant": 'feature',
                    "figureAlignment": 'top',
                    "sparkline": true,
                    "title": {
                        "id": 'sparkline-card-3',
                        "text": 'Illustrative headline',
                        "subtitle": 'England and Wales'
                    },
                    "body": {
                        "id": 'sparkline-text-3',
                        "figure": '6.15 Million households',
                        "text": 'An illustrative figure with a decorative trend line'
                    }
                })
            }}
        </div>
    </div>
</div>
