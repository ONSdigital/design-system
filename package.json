{
    "name": "@ons/design-system",
    "description": "ONS Design System built CSS, JS, and Nunjucks templates",
    "version": "3.0.1",
    "main": "index.js",
    "license": "MIT",
    "author": {
        "name": "ONS Digital"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ONSdigital/design-system"
    },
    "scripts": {
        "start": "gulp start",
        "watch": "gulp watch",
        "test": "gulp build-assets && TEST_PORT=3020 TEST_WITH_PUPPETEER=1 jest '.*\\.spec\\.js'",
        "test:clear-cache": "jest --clearCache",
        "test:no-build": "TEST_PORT=3020 TEST_WITH_PUPPETEER=1 jest '.*\\.spec\\.js'",
        "test:with-log": "yarn test --no-color 2>test.log",
        "test:start-server": "TEST_PORT=3020 gulp start-dev-server",
        "test-lighthouse": "yarn build && node ./lighthouse/lighthouse-get-urls.js && lhci autorun --config=./lighthouse/lighthouserc.js",
        "build": "yarn && yarn tidy-clean && NODE_ENV=production gulp build",
        "build-serve": "yarn build && gulp start-dev-server",
        "verify-assets": "node ci/verify-assets.mjs",
        "npm-bundle": "NODE_ENV=production yarn tidy-clean && NODE_ENV=production gulp build-package && yarn verify-assets && babel-node ci/generate-npm-package.js",
        "cdn-bundle": "NODE_ENV=production yarn tidy-clean && NODE_ENV=production gulp build-package && yarn verify-assets && babel-node ci/prepare-templates-for-zip.js",
        "test-visual": "yarn build && gulp run-backstop-tests",
        "test-visual:reference": "yarn build && gulp run-backstop-reference",
        "test-visual:approve": "gulp run-backstop-approve",
        "tidy-clean": "rm -rf build css favicons fonts img components layout scripts coverage scss js",
        "check-unused": "npx npm-check-unused",
        "dedupe-deps": "npx yarn-deduplicate yarn.lock",
        "lint": "prettier --check . && eslint '**/*.{js,mjs}' && stylelint '**/*.scss' && remark . --ext md --ignore-path .remarkignore --frail",
        "lint:fix": "prettier --write . && eslint --fix '**/*.{js,mjs}' && stylelint '**/*.scss' --fix && remark . --ext md --ignore-path .remarkignore --output",
        "prepack": "pinst --disable",
        "postpack": "pinst --enable"
    },
    "lint-staged": {
        "*.{js,mjs}": [
            "prettier --check",
            "eslint"
        ],
        "*.md": [
            "prettier --check",
            "remark --ext md --ignore-path .remarkignore --frail"
        ],
        "*.scss": [
            "prettier --check",
            "stylelint"
        ],
        "*.{yml,yaml,njk,html}": [
            "prettier --check"
        ]
    },
    "browserslist": [
        "last 2 versions",
        "not dead"
    ],
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/eslint-parser": "7.29.7",
        "@babel/node": "7.29.0",
        "@babel/plugin-syntax-dynamic-import": "7.8.3",
        "@babel/plugin-transform-class-properties": "7.29.7",
        "@babel/plugin-transform-modules-commonjs": "7.28.6",
        "@babel/plugin-transform-runtime": "7.29.0",
        "@babel/preset-env": "7.29.3",
        "@babel/register": "7.29.3",
        "@babel/runtime": "7.29.2",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@stylistic/stylelint-plugin": "5.3.0",
        "abortcontroller-polyfill": "1.7.8",
        "autoprefixer": "10.6.1",
        "babel-plugin-istanbul": "8.0.0",
        "babelify": "10.0.0",
        "backstopjs": "6.3.25",
        "browser-sync": "3.0.4",
        "browserify": "17.0.1",
        "chalk": "4.1.2",
        "cheerio": "1.2.0",
        "core-js": "3.50.0",
        "cors": "2.8.6",
        "dialog-polyfill": "0.5.6",
        "dompurify": "3.4.15",
        "eslint": "9.39.2",
        "eslint-cli": "1.1.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-unused-imports": "4.4.1",
        "express": "5.2.1",
        "front-matter": "4.0.2",
        "fs-extra": "11.4.0",
        "fuse.js": "7.5.0",
        "glob": "13.0.6",
        "globals": "17.12.0",
        "gulp": "5.0.1",
        "gulp-babel": "8.1.0",
        "gulp-cli": "3.1.0",
        "gulp-dart-sass": "1.1.0",
        "gulp-if": "3.0.0",
        "gulp-postcss": "10.0.0",
        "gulp-sourcemaps": "3.0.0",
        "gulp-terser": "2.1.0",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jest": "30.5.1",
        "jest-axe": "11.0.0",
        "jest-environment-jsdom": "30.5.1",
        "jest-puppeteer": "11.0.0",
        "jsdom": "30.1.0",
        "lighthouse": "13.4.1",
        "lint-staged": "17.5.1",
        "lodash": "4.18.1",
        "mdn-polyfills": "5.20.0",
        "normalize.css": "8.0.1",
        "nunjucks": "3.2.4",
        "pinst": "3.0.0",
        "postcss": "8.5.28",
        "postcss-url": "10.1.4",
        "prepend-file": "2.0.1",
        "prettier": "3.9.7",
        "prettier-plugin-jinja-template": "2.2.0",
        "puppeteer": "25.11.0",
        "remark-cli": "12.0.1",
        "remark-lint": "10.0.1",
        "remark-preset-lint-recommended": "7.0.1",
        "stylelint": "17.15.0",
        "stylelint-config-recommended-scss": "17.0.1",
        "stylelint-config-sass-guidelines": "13.0.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-order": "8.1.1",
        "stylelint-scss": "7.3.0",
        "through2": "5.0.11",
        "tick-manager": "1.0.3",
        "util": "0.12.5",
        "viewport-details": "3.0.4",
        "vinyl-buffer": "1.0.1",
        "vinyl-source-stream": "2.0.0",
        "whatwg-fetch": "3.6.20"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "highcharts": "12.1.2",
        "pym.js": "1.3.2",
        "uuid": "14.0.2"
    },
    "resolutions": {
        "backstopjs/puppeteer": "25.11.0",
        "decode-uri-component": "0.5.0",
        "lodash": "4.18.1",
        "jest-environment-node": "30.5.1",
        "micromatch": "4.0.8",
        "postcss": "8.5.23",
        "uuid": "11.1.1",
        "yaml": "2.9.1"
    }
}
